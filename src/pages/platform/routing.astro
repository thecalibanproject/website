---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import EvidenceGrid from '../../components/EvidenceGrid.astro';
import Timeline from '../../components/Timeline.astro';
import CodeTabs from '../../components/CodeTabs.astro';
import StatusTable from '../../components/StatusTable.astro';
import NoteLinks from '../../components/NoteLinks.astro';
import Close from '../../components/air/Close.astro';
import RouteTrace from '../../components/platform/RouteTrace.astro';
import { crates } from '../../data/status';

const evidence = [
  {
    value: 'Up to 98%', bar: { kind: 'fill', values: [98] }, label: 'Lower cost while matching the best single model',
    detail: 'A learned cascade with a scorer that decides when to stop, or +4% accuracy at equal cost.',
    sources: [{ label: 'FrugalGPT', href: 'https://arxiv.org/abs/2305.05176' }],
  },
  {
    value: 'Up to 85%', bar: { kind: 'fill', values: [85] }, label: 'Cost reduction at 95% of GPT-4 quality on MT-Bench',
    detail: 'Binary strong/weak routers trained on Chatbot Arena preferences (repo claim).',
    sources: [{ label: 'RouteLLM', href: 'https://arxiv.org/abs/2406.18665' }],
  },
  {
    value: '97.25% at 24.18%', bar: { kind: 'pair', values: [24.18, 97.25] }, label: 'Share of GPT-4 quality kept, at a fraction of its cost',
    detail: 'A contextual-bandit router with a latency penalty and continual learning. BEST-Route and AutoMix report 50–60%.',
    sources: [{ label: 'MixLLM', href: 'https://arxiv.org/abs/2502.18482' }, { label: 'BEST-Route', href: 'https://arxiv.org/abs/2506.22716' }, { label: 'AutoMix', href: 'https://arxiv.org/abs/2310.12963' }],
  },
  {
    value: '21 of 29', bar: { kind: 'fill', values: [72.4] }, label: 'Routable questions captured by one model per task type',
    detail: 'Twenty-one routing methods sit within a fraction of a point of each other. Run-to-run label noise is 5.37%.',
    sources: [{ label: 'Routing Gap Is Task Type, 2026', href: 'https://arxiv.org/abs/2608.23023' }],
  },
  {
    value: '>90%', bar: { kind: 'fill', values: [90], open: true }, label: 'Success of query-independent “confounder gadgets” on open routers',
    detail: 'Adversarial suffixes push weak queries to the strong model. The attack transfers to commercial routers.',
    caveat: 'This is a risk, not a saving: router integrity is a security surface.',
    sources: [{ label: 'Rerouting LLM Routers (COLM’25)', href: 'https://arxiv.org/abs/2501.01818' }],
  },
  {
    value: '~200 µs', label: 'Overhead of a lightweight router, vs tens to hundreds of ms for a 1.5B generative router on every call',
    detail: 'Why the LLM stage only sees low-confidence traffic, under a hard timeout.',
    caveat: 'The generative-router figure is inferred from model size in note 02, not measured.',
    sources: [{ label: 'HW-Router', href: 'https://arxiv.org/abs/2608.14575' }],
  },
];

const stages = [
  { n: '0', title: 'Rules and policy', target: '< 0.1 ms', status: 'built' as const, body: 'Pinned model, header overrides, context length vs window, data-classification tags (a PII class can force on-prem only), allow and deny lists, budget state. Emits a feasible model set or a forced route.' },
  { n: '1', title: 'Embedding kNN', target: '2–8 ms CPU', status: 'wip' as const, body: 'One small embedding per request, shared with the semantic cache and RAG, matched against per-tenant labelled exemplars. Exits when the vote margin and similarity clear their thresholds.' },
  { n: '2', title: 'Small classifier', target: '5–20 ms CPU', status: 'wip' as const, statusLabel: 'Placeholder today', body: 'A ModernBERT multi-head model via ONNX: intent, difficulty, reasoning needed, out-of-scope, jailbreak and PII presence. Today a keyword classifier stands in so routing works end to end.' },
  { n: '3', title: 'LLM fallback', target: '≤ 5–10% of traffic', status: 'wip' as const, body: 'An Arch-Router-class model sees only the top-k candidate routes, under a hard timeout (e.g. 150 ms) that falls back to the tenant’s default route.' },
  { n: '4', key: true, title: 'Pick a model within the route', target: '< 0.5 ms', status: 'built' as const, statusLabel: 'Ordered candidates today', body: 'Today: the tenant’s ordered candidates, filtered by trust tier, with fallbacks. Designed: score = quality − λ·cost − λ·latency, with LinUCB exploration inside a budget.' },
];

const tiers = [
  ['T0', 'Sovereign or local model', 'No redaction needed; logs are still scrubbed'],
  ['T1', 'Attested TEE', 'Same as T0 if attestation verifies'],
  ['T2', 'Contracted provider with zero data retention', 'Pseudonymize direct identifiers'],
  ['T3', 'Unknown', 'Strict: generalize quasi-identifiers, run the verifier, fail closed'],
];

const routesToml = `# core/config/caliban.example.toml
[[tenants]]
id = "acme"
pii_mode = "reversible"

  # Local, on-prem model server (vLLM, SGLang, llama.cpp, Ollama, …). No key needed.
  [[tenants.providers]]
  id = "local-llm"
  kind = "openai_compatible"
  base_url = "http://llm:8000/v1"
  trust_tier = "t0_sovereign"

  # Customer-supplied key (BYOK). Remove this block for fully air-gapped deployments.
  [[tenants.providers]]
  id = "openai"
  kind = "openai"
  base_url = "https://api.openai.com/v1"
  trust_tier = "t2_contracted"
  api_key = { env = "ACME_OPENAI_API_KEY" }

  # Intent → ordered candidate models (first = preferred, rest = fallbacks).
  [[tenants.routes]]
  intent = "default"
  models = ["local/gpt-oss-20b", "openai/gpt-5-mini"]

  [[tenants.routes]]
  intent = "chat"
  models = ["local/qwen3-8b", "local/gpt-oss-20b"]

  [[tenants.routes]]
  intent = "code"
  models = ["local/gpt-oss-20b"]`;

const routeRs = `// core/crates/caliban-route/src/lib.rs
//! Staged pipeline; each stage may exit early:
//! 0. rules/policy (pinned model, trust tier, licence) — implemented
//! 1. embedding kNN over tenant exemplars — TODO (shares the request embedding with the cache)
//! 2. ONNX multi-head classifier (intent, difficulty, OOS, jailbreak) — TODO, artifacts from \`ml/\`
//! 3. small-LLM fallback for ambiguous traffic — TODO
//! 4. pick a model within the route: ordered candidates now; cost/latency scoring + bandit later

/// Outcome of routing: an ordered list of models to try (first preferred, rest fallbacks).
pub struct RouteDecision {
    pub intent: String,
    pub confidence: f32,
    pub candidates: Vec<ModelId>,
    /// Which stage decided; logged for offline router evaluation.
    pub stage: &'static str,
}

/// Request-level constraints from policy (e.g. sensitive data must stay on sovereign models).
pub struct Constraints {
    /// Worst tier the request may be sent to. \`T0Sovereign\` = never leave the boundary.
    pub max_tier: TrustTier,
}`;

const headers = `# Response headers on every /v1/chat/completions and /v1/messages call
x-caliban-request-id: <id>
x-caliban-routed-model: <the model that answered, e.g. local/gpt-oss-20b>
x-caliban-cache: hit | miss | bypass
x-caliban-pii-entities: <count>
x-caliban-cost-usd: <cost>          # non-streaming only, when the model has a price`;
---
<Base title="Routing" description="Caliban classifies each request by intent and sends it to the cheapest model that clears the bar, within the tenant's trust tiers and policies. Every decision is logged and returned in response headers.">
  <PageHero
    crumbs={[{ label: 'Platform' }, { label: 'Routing' }]}
    title="Send each request to the cheapest model that clears the bar"
    lead="Most of the routing gain comes from knowing the task type. Caliban uses a cheap, explainable, staged router: rules first, then embeddings and a small classifier, with an LLM only as a fallback. Tenants declare the routes; Caliban learns which model serves each one best."
  >
    <Fragment slot="actions">
      <a class="btn btn-primary" href="#stages">See the stages</a>
      <a class="btn btn-secondary" href="/research/02-intent-classification-and-routing/">Read research note 02</a>
    </Fragment>
    <RouteTrace slot="visual" />
  </PageHero>

  <EvidenceGrid
    id="evidence"
    title="Routing is a real cost lever, and simple routers are hard to beat"
    lead="Published results report large savings at roughly equal quality. The 2025–2026 benchmark wave adds a caution: most methods land within noise of each other, and routers can be gamed."
    items={evidence}
    notes={[{ label: 'note 02', href: '/research/02-intent-classification-and-routing/' }]}
  />

  <section class="section paper" id="stages" aria-labelledby="stages-title">
    <div class="container">
      <div class="head">
        <h2 id="stages-title">A staged router that fails toward the tenant default</h2>
        <p>A route is more than a model: it is an intent, the nodes and datasources that serve it, the candidate models and the reasoning effort. Each stage may exit early, and every stage has a timeout. A router failure never blocks a request.</p>
      </div>
      <div class="split how">
        <div class="sticky-col">
          <dl class="ledger targets" style="--dt:132px" aria-label="Router overhead targets">
            <div><dt class="cap">Router <span class="nc">p50</span></dt><dd><span class="datum">&lt; 10 ms</span><span class="badge badge-target">Target</span></dd></div>
            <div><dt class="cap">Router <span class="nc">p99</span></dt><dd><span class="datum">&lt; 30 ms</span><span class="badge badge-target">Target</span></dd></div>
            <div><dt class="cap">Excludes</dt><dd>The LLM fallback. Either figure is small next to a model’s time to first token.</dd></div>
          </dl>
          <p class="callout warn mt"><span class="callout-k">Targets</span><span>Latency figures are <strong>design targets</strong> to benchmark, not measurements. Status badges come from <code>core/README.md</code>.</span></p>
        </div>
        <Timeline items={stages} label="Routing stages" />
      </div>
    </div>
  </section>

  <section class="section scope" aria-labelledby="cfg-title">
    <div class="container">
      <div class="head">
        <h2 id="cfg-title">Routes are plain config, and every decision is visible</h2>
        <p>A tenant declares an ordered list of candidate models per intent. The first is preferred; the rest are fallbacks. A candidate whose provider the tenant has not configured is skipped, and a policy constraint can exclude every candidate above a trust tier.</p>
      </div>
      <div class="split split-wide">
        <div>
          <div class="rich">
            <p>Ask for <code>caliban/auto</code> and the router decides. A tenant alias is resolved by policy, and any other model id must exist in the tenant’s registry.</p>
          </div>
          <ul class="checks mt">
            <li><strong>Sensitive stays local.</strong> The cost function carries a privacy penalty, so sensitive requests prefer sovereign models when a capable one exists.</li>
            <li><strong>Every decision is logged</strong> with its stage, scores and propensity, for offline evaluation.</li>
            <li><strong>The answer says where it came from</strong> in <code>x-caliban-routed-model</code>.</li>
          </ul>
        </div>
        <CodeTabs id="route-tabs" maxHeight={600} tabs={[
          { label: 'Tenant routes (TOML)', code: routesToml, lang: 'toml' },
          { label: 'caliban-route (Rust)', code: routeRs, lang: 'rust' },
          { label: 'Response headers', code: headers, lang: 'yaml' },
        ]} caption="Excerpts from core/config/caliban.example.toml and core/crates/caliban-route; header values are placeholders." />
      </div>
    </div>
  </section>

  <section class="section paper" aria-labelledby="tiers-title">
    <div class="container">
      <div class="head">
        <h2 id="tiers-title">Where a request may go decides how it is treated</h2>
        <p>Providers and models carry a trust tier. Tenant policy can keep sensitive traffic on local models even when a BYOK provider is configured.</p>
      </div>
      <ol class="strip-bay tiers" aria-label="Trust tiers">
        {tiers.map(([t, d, x]) => (
          <li class="strip">
            <span class="code-cell"><span class="tier-k">{t}</span></span>
            <h3 class="strip-title">{d}</h3>
            <p>{x}</p>
          </li>
        ))}
      </ol>
      <ul class="rgrid ops" style="--n:3">
        <li>
          <h3>Bring your own model</h3>
          <p>Register the endpoint and price; Caliban runs a probe set of about 1–2k prompts stratified by intent cluster, giving a quality vector per cluster. The model is routable immediately, without retraining the router.</p>
        </li>
        <li>
          <h3>Learn from production</h3>
          <p>Retrain offline every night. Promote a new router only when off-policy evaluation beats both the current router and the “one model per intent” baseline, and roll back on cost or SLO alarms.</p>
        </li>
        <li>
          <h3>Guard against gaming</h3>
          <p>Spend caps per tenant and route, audit sampling, and alarms when traffic shifts toward the top-tier model. Safety classification runs before any cascade.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section-tight paper ruled" aria-labelledby="status-title">
    <div class="container">
      <div class="head">
        <h2 id="status-title" class="head-sm">What is built in core today</h2>
        <p>Rules, trust-tier constraints, ordered candidates and fallbacks work end to end. The kNN stage, the ONNX heads and the bandit are designed, not yet built.</p>
      </div>
      <StatusTable rows={crates('caliban-route', 'caliban-providers')} />
    </div>
  </section>

  <NoteLinks slugs={['02-intent-classification-and-routing']} platform="/platform/routing/" />
  <Close />
</Base>

<style>
  .mt { margin-top: 24px; }
  .ruled { border-top: 1px solid var(--rule); }
  .sticky-col { position: sticky; top: calc(var(--nav-h) + 32px); }
  .how { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
  .side-cap { color: var(--ink-3); margin-bottom: 10px; }
  .targets dd { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .targets .datum { color: var(--ink); font-size: 0.88rem; font-weight: 700; }
  .targets .nc { font-family: var(--mono); text-transform: none; letter-spacing: 0; }

  ol.strip-bay, ul.rgrid { list-style: none; margin: 0; padding: 0; }
  .tiers .strip { --cols: 80px minmax(0, 0.9fr) minmax(0, 1.4fr); }
  .tiers .strip-title { align-self: center; font-size: 1.15rem; }
  .tiers .strip > p { align-self: center; }
  .tier-k { font-family: var(--mono); font-weight: 600; font-size: 1.35rem; line-height: 1; font-variant-numeric: slashed-zero; }
  .rgrid.ops { margin-top: 28px; }

  @media (max-width: 1080px) {
    .sticky-col { position: static; }
    .how { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 760px) {
    .tiers .strip { --cols: 64px minmax(0, 1fr); }
    .tiers .strip > p { grid-column: 2; border-top: 1px solid var(--rule); }
    .tiers .code-cell { grid-row: 1 / 3; }
  }
</style>
