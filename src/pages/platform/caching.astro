---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import EvidenceGrid, { type EvidenceItem } from '../../components/EvidenceGrid.astro';
import CodeTabs from '../../components/CodeTabs.astro';
import StatusTable from '../../components/StatusTable.astro';
import NoteLinks from '../../components/NoteLinks.astro';
import Close from '../../components/air/Close.astro';
import { crates } from '../../data/status';

const evidence: EvidenceItem[] = [
  {
    value: '0.05–0.1× input', bar: { kind: 'span', values: [5, 10] }, label: 'What provider prompt-cache reads cost, relative to normal input',
    detail: 'The biggest saving per unit of engineering is steering provider caches with stable prefixes, not building another cache.',
    sources: [{ label: 'Anthropic docs', href: 'https://platform.claude.com/docs/en/docs/build-with-claude/prompt-caching' }, { label: 'OpenAI docs', href: 'https://developers.openai.com/api/docs/guides/prompt-caching' }],
  },
  {
    value: '12 of 28', bar: { kind: 'fill', values: [42.9] }, label: 'OpenRouter model labels that showed cross-account cache reads',
    detail: '33.7% of volume. All five open-source gateways tested leaked across customers by pooling upstream keys.',
    sources: [{ label: 'KeyPooling 2026', href: 'https://arxiv.org/abs/2608.17485' }],
  },
  {
    value: '12.5× · 26×', label: 'More hits and lower error from per-entry learned thresholds',
    detail: 'Compared with one static similarity threshold, under a user-specified error bound.',
    sources: [{ label: 'vCache (ICLR 2026)', href: 'https://arxiv.org/abs/2502.03771' }],
  },
  {
    value: '51.5% → 1.5%', bar: { kind: 'shift', values: [51.5, 1.5] }, label: 'Unsafe cached RAG answers under document drift, with source-version gates',
    detail: 'Reuse only when similarity, evidence overlap, source version and lexical support all pass.',
    sources: [{ label: 'GroundedCache 2026', href: 'https://arxiv.org/abs/2605.27494' }],
  },
  {
    value: '86%', bar: { kind: 'fill', values: [86] }, label: 'Response hijack rate from embedding-key collisions on semantic caches',
    detail: '90.6% for agent tool calls. Salting cut hits by only 21%: the case against any cross-tenant semantic cache.',
    sources: [{ label: 'Key Collision Attack 2026', href: 'https://arxiv.org/abs/2601.23088' }],
  },
  {
    value: '−50% · −27%', label: 'Cost and latency from caching agent plans instead of answers',
    detail: 'Plans depend on schema, not live data, so they stay valid longer.',
    sources: [{ label: 'Agentic Plan Caching (NeurIPS 2025)', href: 'https://arxiv.org/abs/2506.14852' }],
  },
];

type St = 'built' | 'wip' | 'design';
const tiers: { t: string; name: string; what: string; key: string; when: string; status: { s: St; l: string }[] }[] = [
  { t: 'T0', name: 'Provider prefix steering', what: 'Make upstream prompt caching hit: canonical ordering, deterministic serialization, automatic cache_control breakpoints and a per-tenant prompt_cache_key.', key: 'Provider-side', when: 'Always: the biggest lever.', status: [{ s: 'built', l: 'Per-tenant identity (BYOK)' }, { s: 'built', l: 'cache_control kept' }, { s: 'design', l: 'Ordering + breakpoints' }] },
  { t: 'T1', name: 'Exact-match response cache', what: 'Full response replay, keyed on the pseudonymized request, the caller’s ACL fingerprint and the datasource epochs.', key: 'BLAKE3', when: 'Deterministic requests without side-effecting tools.', status: [{ s: 'built', l: 'In-process (moka)' }, { s: 'wip', l: 'Shared Valkey tier' }] },
  { t: 'T2', name: 'Semantic response cache', what: 'Nearest neighbour on the pseudonymized last turn, with per-entry learned thresholds, slot equality (numbers, dates, ids) and an epoch check.', key: 'ANN per (tenant, intent, ACL)', when: 'Allowlisted intents only (FAQ, docs QA, definitional).', status: [{ s: 'wip', l: 'Trait only' }] },
  { t: 'T2b', name: 'Near-hit as a hint', what: 'Just below threshold, the cached question and answer become a few-shot example instead of the answer.', key: 'Same as T2', when: 'Analytics and NL-to-code intents.', status: [{ s: 'design', l: 'Designed' }] },
  { t: 'T3', name: 'Plan and tool-result cache', what: 'Cache agent plans and read-only tool results, keyed by intent, tool-schema hashes, arguments and datasource epoch.', key: 'Canonical intent + slots', when: 'Nodes; tools must declare idempotency and dependencies.', status: [{ s: 'design', l: 'Designed' }] },
  { t: 'T4', name: 'KV and prefix reuse on-prem', what: 'vLLM or SGLang prefix caching where Caliban runs inference, isolated per tenant with a request cache_salt.', key: 'Engine-side + tenant salt', when: 'Sovereign and on-prem deployments.', status: [{ s: 'built', l: 'Per-tenant cache_salt' }] },
];

const order = [
  { k: 'tools', w: 18 },
  { k: 'system', w: 20 },
  { k: 'ontology / context modules', w: 30 },
  { k: 'history', w: 18 },
  { k: 'user', w: 14 },
];

const keyRs = `// core/crates/caliban-cache/src/lib.rs
/// Inputs that determine whether two requests may share a cached response.
pub struct CacheKeyParts<'a> {
    pub tenant: &'a TenantId,
    /// \`ChatRequest::canonical_hash\` of the pseudonymized request with the resolved model.
    pub request_hash: blake3::Hash,
    /// Hash of the (datasource, row/column policy) set the caller is entitled to; empty if ungrounded.
    pub acl_fingerprint: &'a [u8],
    /// \`(datasource id, epoch)\` pairs the answer depends on, sorted.
    pub datasource_epochs: &'a [(String, u64)],
    pub pii_mode: PiiMode,
}

pub fn cache_key(p: &CacheKeyParts<'_>) -> CacheKey {
    let mut h = blake3::Hasher::new();
    h.update(b"caliban/t1/v1\\0");
    h.update(p.tenant.as_str().as_bytes());
    h.update(&[0]);
    h.update(p.request_hash.as_bytes());
    h.update(&(p.acl_fingerprint.len() as u64).to_le_bytes());
    h.update(p.acl_fingerprint);
    for (ds, epoch) in p.datasource_epochs {
        h.update(ds.as_bytes());
        h.update(&[0]);
        h.update(&epoch.to_le_bytes());
    }
    h.update(&[p.pii_mode as u8]);
    *h.finalize().as_bytes()
}`;

const testRs = `// core/crates/caliban-cache/src/lib.rs (tests)
#[test]
fn key_changes_with_tenant_acl_and_epoch() {
    let a: TenantId = "a".into();
    let b: TenantId = "b".into();
    let e1 = vec![("dw".to_string(), 1)];
    let e2 = vec![("dw".to_string(), 2)];
    let base = cache_key(&parts(&a, b"acl", &e1));
    assert_ne!(base, cache_key(&parts(&b, b"acl", &e1)), "tenant isolation");
    assert_ne!(base, cache_key(&parts(&a, b"acl2", &e1)), "acl scoping");
    assert_ne!(base, cache_key(&parts(&a, b"acl", &e2)), "datasource invalidation");
    assert_eq!(base, cache_key(&parts(&a, b"acl", &e1)));
}`;

const saltRs = `// core/crates/caliban-gateway/src/quirks.rs
//! - Prefix-cache isolation: adds a per-tenant \`cache_salt\` for engines that support it, so one
//!   tenant cannot probe another's cached prefixes through timing.
if provider.cache_salt {
    obj.insert("cache_salt".into(), Value::String(tenant_salt.to_owned()));
}

// core/crates/caliban-gateway/src/lib.rs: the salt key is derived from CALIBAN_KEK,
// so every router in a deployment computes the same per-tenant salt.
Ok(kek) => blake3::derive_key("caliban 2026 tenant cache_salt v1", kek),`;

const cfgToml = `# core/config/caliban.example.toml
[cache]
exact_enabled = true
exact_max_entries = 100000
exact_ttl_secs = 3600

# core/config/open-models.example.toml: a shared vLLM pool
[[providers]]
id = "vllm-qwen3-large"
kind = "openai_compatible"
base_url = "http://qwen3-large:8000/v1"
trust_tier = "t0_sovereign"
cache_salt = true      # only for vLLM / SGLang pools

# Per request: "caliban": { "cache": "exact" }   # off | exact | semantic`;

const efficiency = [
  ['Provider prompt-cache steering', 'Stable prefix order and per-tenant cache keys.'],
  ['Routing', 'Cheap models for easy intents.'],
  ['T1 exact cache', 'Invalidated by datasource epochs.'],
  ['Ontology lane A', 'Small models make bounded choices instead of large models writing SQL.'],
  ['Plan cache for nodes', 'Reuse plans, not answers that depend on live data.'],
  ['T2 semantic cache', 'Allowlisted intents only.'],
  ['RAG hygiene', 'Token budget with a rerank-score cutoff; compression off by default.'],
  ['On-prem KV reuse', 'Prefix caching in vLLM or SGLang with per-tenant salts.'],
];
---
<Base title="Caching" description="Caliban cuts tokens by steering provider prompt caches with stable prefixes and per-tenant identities, then adds tenant-scoped exact and semantic caches that are invalidated when your data changes.">
  <PageHero
    crumbs={[{ label: 'Platform' }, { label: 'Caching' }]}
    title="Fewer tokens, without sharing a cache across tenants"
    lead="The cheapest token is one the provider already has cached. Caliban keeps prompt prefixes stable so provider caches hit, gives every tenant its own upstream identity, and adds exact and semantic caches that are scoped to the tenant and invalidated when the underlying data changes."
  >
    <Fragment slot="actions">
      <a class="btn btn-primary" href="#tiers">See the cache tiers</a>
      <a class="btn btn-secondary" href="/research/01-semantic-caching-and-rust-vector-stack/">Read research note 01</a>
    </Fragment>
    <div slot="visual" class="pv" role="img" aria-label="Canonical prompt order: tools, system, ontology and context modules, history, then the user turn. Everything before the user turn is a stable prefix that the provider can cache per tenant.">
      <p class="pv-label cap">Canonical prompt order</p>
      <div class="pv-bar">
        {order.map((o, i) => <span class:list={['pv-seg', { user: i === order.length - 1 }]} style={`flex:${o.w}`}>{o.k}</span>)}
      </div>
      <div class="pv-brace">
        <span class="pv-brace-line" style="flex:86"><span>stable prefix · cached by the provider</span></span>
        <span class="pv-brace-new" style="flex:14"><span>new</span></span>
      </div>
      <dl class="ledger pv-facts">
        <div><dt class="cap">Read price</dt><dd><span class="datum">0.05–0.1×</span> input</dd></div>
        <div><dt class="cap">Isolation</dt><dd>BYOK key per tenant</dd></div>
        <div><dt class="cap">Compression</dt><dd>Never rewrites the prefix</dd></div>
      </dl>
      <ol class="pv-tiers" aria-hidden="true">
        {[['T0', 'provider'], ['T1', 'exact'], ['T2', 'semantic'], ['T3', 'plans'], ['T4', 'KV']].map(([k, t]) => <li><span class="pv-k">{k}</span><span>{t}</span></li>)}
      </ol>
      <p class="pv-note">Evaluated in order, cheapest first. Every Caliban tier is keyed by tenant.</p>
    </div>
  </PageHero>

  <EvidenceGrid
    id="evidence"
    title="The biggest cheap win is not a semantic cache"
    lead="Static-threshold semantic caches give false hits, shared caches are an attack surface, and gateways are where isolation usually breaks. Steering provider caches is where the money is."
    items={evidence}
    notes={[{ label: 'note 01', href: '/research/01-semantic-caching-and-rust-vector-stack/' }, { label: 'note 06', href: '/research/06-rag-and-token-efficiency/' }]}
  />

  <section class="section paper" id="tiers" aria-labelledby="tiers-title">
    <div class="container">
      <div class="head">
        <h2 id="tiers-title">Six tiers, cheapest first, all scoped to the tenant</h2>
        <p>There is no cross-tenant scope. Keys and stored values use pseudonymized text, and a hit is rehydrated with the current request’s own vault.</p>
      </div>
      <ol class="ctiers">
        {tiers.map((t) => (
          <li class="ctier">
            <span class="ct-t">{t.t}</span>
            <div class="ct-main">
              <h3 class="strip-title">{t.name}</h3>
              <p>{t.what}</p>
            </div>
            <dl class="ct-meta">
              <div><dt class="cap">Key</dt><dd>{t.key}</dd></div>
              <div><dt class="cap">Applies</dt><dd>{t.when}</dd></div>
            </dl>
            <div class="ct-status">
              {t.status.map((s) => <span class:list={['status', s.s === 'built' ? 'built' : 'wip']}>{s.l}</span>)}
            </div>
          </li>
        ))}
      </ol>
      <p class="fine">Status from <code>core/README.md</code> and the gateway source. “Designed” means specified in research note 01 and the reference architecture, not yet built.</p>
    </div>
  </section>

  <section class="section scope" aria-labelledby="key-title">
    <div class="container split split-wide">
      <div>
        <h2 id="key-title" class="sec-title">A key that changes when anything that matters changes</h2>
        <ul class="checks mt">
          <li><strong>Tenant.</strong> Two tenants never share an entry, by construction.</li>
          <li><strong>ACL fingerprint.</strong> A finance answer is never served to someone in sales who cannot see the same data.</li>
          <li><strong>Datasource epochs.</strong> When the data an answer depended on changes, the next lookup is a miss.</li>
          <li><strong>PII mode.</strong> Pseudonymized and masked responses never mix.</li>
        </ul>
        <p class="callout mt"><span class="callout-k">Header</span><span>Every response reports <code>x-caliban-cache</code> as <code>hit</code>, <code>miss</code> or <code>bypass</code>. A <code>x-caliban-tokens-saved</code> header and a savings dashboard are in the design, not yet built.</span></p>
      </div>
      <CodeTabs id="cache-tabs" maxHeight={600} tabs={[
        { label: 'cache_key() (Rust)', code: keyRs, lang: 'rust' },
        { label: 'Isolation test', code: testRs, lang: 'rust' },
        { label: 'Per-tenant cache_salt', code: saltRs, lang: 'rust' },
        { label: 'Config (TOML)', code: cfgToml, lang: 'toml' },
      ]} caption="Excerpts from core/crates/caliban-cache, core/crates/caliban-gateway and core/config." />
    </div>
  </section>

  <section class="section paper" aria-labelledby="eff-title">
    <div class="container">
      <div class="head">
        <h2 id="eff-title">Where the savings come from</h2>
        <p>The reference architecture ranks every token and latency lever, ordered by return on effort. Caching is three of them; the order matters because compression and reordering can break the provider cache.</p>
      </div>
      <div class="split eff-grid">
        <ol class="eff" aria-label="Token and latency levers, ordered by return on effort">
          {efficiency.map(([a, b], i) => (
            <li class:list={{ top: i < 3 }}>
              <span class="eff-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="eff-t"><strong>{a}</strong> {b}</span>
            </li>
          ))}
        </ol>
        <div class="strip-bay">
          <div class="strip">
            <span class="code-cell">BGT</span>
            <div>
              <h3 class="strip-title">A token budget, not a stuffed window</h3>
              <p>Stop adding retrieved chunks at the reranker score cliff and reorder them against “lost in the middle”. More context often lowers quality.</p>
            </div>
          </div>
          <div class="strip">
            <span class="code-cell">CMP</span>
            <div>
              <h3 class="strip-title">Compression is off by default</h3>
              <p>If enabled, it is extractive only, applies only to long retrieved context, and never touches the cached prefix.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-tight paper status-sec" aria-labelledby="status-title">
    <div class="container">
      <div class="head solo">
        <h2 id="status-title" class="head-sm">What is built in core today</h2>
      </div>
      <StatusTable rows={crates('caliban-cache', 'caliban-rag', 'caliban-gateway')} />
    </div>
  </section>

  <NoteLinks slugs={['01-semantic-caching-and-rust-vector-stack', '06-rag-and-token-efficiency']} platform="/platform/caching/" />
  <Close />
</Base>

<style>
  .mt { margin-top: 24px; }
  .fine { margin-top: 14px; color: var(--ink-3); font-size: 0.86rem; }
  .sec-title { font-size: clamp(1.7rem, 3.2vw, 2.6rem); }
  .status-sec { border-top: 1px solid var(--rule); }

  /* Hero instrument: the canonical prompt as a segmented strip. */
  .pv-label { color: var(--readout-3); }
  .pv-bar { display: flex; margin-top: 12px; border: 1px solid var(--scope-line-2); }
  .pv-seg { min-width: 0; padding: 18px 8px; background: var(--scope-3); color: var(--readout); font-family: var(--mono); font-size: 0.7rem; text-align: center; line-height: 1.35; overflow-wrap: anywhere; }
  .pv-seg + .pv-seg { border-left: 1px solid var(--scope-line-2); }
  .pv-seg.user { background: var(--blue); color: #fff; font-weight: 600; }
  .pv-brace { display: flex; margin-top: 8px; }
  .pv-brace-line, .pv-brace-new { position: relative; display: flex; justify-content: center; padding-top: 12px; font-size: 0.82rem; color: var(--readout-3); text-align: center; }
  .pv-brace-line::before, .pv-brace-new::before { content: ''; position: absolute; top: 0; left: 2px; right: 2px; height: 7px; border: 1px solid var(--target); border-top: 0; }
  .pv-brace-new::before { border-color: var(--scope-line-2); }
  .pv-brace-line span { color: var(--target); }
  .pv-facts { margin-top: 20px; --dt: 120px; }
  .pv-facts dd { color: var(--readout); }
  .pv-facts .datum { font-size: 0.86rem; }
  .pv-tiers { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; background: var(--scope-line-2); border: 1px solid var(--scope-line-2); }
  .pv-tiers li { display: grid; background: var(--scope-2); }
  .pv-tiers li > span { padding: 6px 8px; font-size: 0.82rem; color: var(--readout-2); }
  .pv-k { background: var(--blue); color: #fff !important; font-family: var(--mono); font-weight: 600; font-size: 0.72rem !important; }
  .pv-note { margin-top: 10px; font-size: 0.84rem; color: var(--readout-3); }

  /* Cache tiers as strips. */
  .ctiers { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .ctier { display: grid; grid-template-columns: 72px minmax(0, 1.4fr) minmax(0, 1fr) 230px; background: var(--strip); border: 1px solid var(--rule); }
  .ctier > * { padding: 16px 18px; min-width: 0; }
  .ctier > * + * { border-left: 1px solid var(--rule); }
  .ct-t { background: var(--blue); color: #fff; font-family: var(--mono); font-weight: 600; font-size: 0.85rem; }
  .ct-main p { margin-top: 6px; color: var(--ink-2); font-size: 0.95rem; line-height: 1.6; }
  .ct-meta { margin: 0; display: grid; gap: 10px; align-content: start; }
  .ct-meta dt { color: var(--ink-3); }
  .ct-meta dd { margin: 2px 0 0; font-size: 0.9rem; color: var(--ink-2); line-height: 1.5; }
  .ct-status { display: flex; flex-wrap: wrap; gap: 6px; align-content: start; }

  /* Levers ranked by return on effort: the rank carries the information. */
  .eff-grid { align-items: start; }
  .eff { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .eff li { display: grid; grid-template-columns: 56px minmax(0, 1fr); background: var(--strip); border: 1px solid var(--rule); }
  .eff-n { background: var(--strip-2); color: var(--ink); font-family: var(--mono); font-weight: 600; font-size: 0.78rem; padding: 12px; }
  .eff li.top .eff-n { background: var(--blue); color: #fff; }
  .eff-t { padding: 12px 16px; border-left: 1px solid var(--rule); color: var(--ink-3); font-size: 0.95rem; line-height: 1.5; }
  .eff strong { color: var(--ink); font-weight: 600; }

  @media (max-width: 1080px) {
    .ctier { grid-template-columns: 64px minmax(0, 1fr); }
    .ct-t { grid-row: 1 / 4; }
    .ct-meta, .ct-status { grid-column: 2; border-top: 1px solid var(--rule); }
  }
  @media (max-width: 560px) {
    .ctier { grid-template-columns: 52px minmax(0, 1fr); }
    .ctier > * { padding: 14px; }
    .pv-seg { padding: 12px 3px; font-size: 0.58rem; }
    .pv-tiers { grid-template-columns: minmax(0, 1fr); }
    .pv-tiers li { grid-template-columns: 52px minmax(0, 1fr); }
  }
</style>
