<script>
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      const hex = b.dataset.copy!;
      try {
        await navigator.clipboard.writeText(hex);
        b.classList.add('copied');
        if (status) status.textContent = `${hex} copied`;
        setTimeout(() => b.classList.remove('copied'), 1200);
      } catch {
        if (status) status.textContent = `Copy failed; the value is ${hex}`;
      }
    });
  });

  const demo = document.querySelector<HTMLFormElement>('[data-demo-keys]');
  const demoData = document.querySelector<HTMLScriptElement>('[data-demo-shapes]');
  if (demo && demoData) {
    const shapes = JSON.parse(demoData.textContent || '[]') as Record<string, string>[];
    demo.addEventListener('change', () => {
      const id = new FormData(demo).get('demo-shape');
      const s = shapes.find((x) => x.id === id);
      if (!s) return;
      demo.querySelectorAll<HTMLElement>('[data-k]').forEach((el) => { el.textContent = s[el.dataset.k!] ?? ''; });
    });
  }
</script>
