---
import { RESEARCH } from '../../data/research';
---
<section class="section paper notes" aria-labelledby="notes-title">
  <div class="container">
    <div class="head">
      <h2 id="notes-title">Nine research notes. Every claim sourced.</h2>
      <p>The design rests on cited literature reviews, each ending in a recommendation and its open questions. Read them before you believe us.</p>
    </div>
    <label class="filter">
      <span class="cap">Filter</span>
      <input type="search" placeholder="routing, mongodb, pii, qwen…" data-filter aria-describedby="notes-count" />
      <span class="datum count" id="notes-count" data-count aria-live="polite">{RESEARCH.length} notes</span>
    </label>
    <ol class="note-list" data-notes>
      {RESEARCH.map((r) => (
        <li data-text={`${r.short} ${r.blurb} ${r.tags.join(' ')}`.toLowerCase()}>
          <a class="note strip-link" href={`/research/${r.slug}/`}>
            <span class="n-code">{r.num}</span>
            <span class="n-title">{r.short}</span>
            <span class="n-blurb">{r.blurb}</span>
            <span class="n-tags datum">{r.tags.join(' · ')}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="none" data-none hidden>No note matches. Try another word or <a href="/research/">browse all notes</a>.</p>
  </div>
</section>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-filter]');
  const items = [...document.querySelectorAll<HTMLLIElement>('[data-notes] > li')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const none = document.querySelector<HTMLElement>('[data-none]');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let n = 0;
    items.forEach((li) => { const show = !q || (li.dataset.text ?? '').includes(q); li.hidden = !show; if (show) n++; });
    if (count) count.textContent = `${n} ${n === 1 ? 'note' : 'notes'}`;
    if (none) none.hidden = n > 0;
  });
</script>

<style>
  .filter { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 14px; border: 1px solid var(--rule-2); background: var(--strip); padding: 0 14px; margin-bottom: 14px; }
  .filter .cap { color: var(--ink-3); }
  .filter input { border: 0; background: transparent; font: inherit; font-size: 1rem; padding: 13px 0; color: var(--ink); min-width: 0; }
  .filter input:focus { outline: none; }
  .filter:focus-within { border-color: var(--blue); box-shadow: inset 0 0 0 1px var(--blue); }
  .count { color: var(--ink-3); }
  .note-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .note { display: grid; grid-template-columns: 64px minmax(0, 0.9fr) minmax(0, 1.3fr) minmax(0, 0.55fr); background: var(--strip); border: 1px solid var(--rule); color: var(--ink); }
  .note > span { padding: 14px 16px; min-width: 0; }
  .note > span + span { border-left: 1px solid var(--rule); }
  .n-code { background: var(--blue); color: #fff; font-family: var(--mono); font-stretch: 87.5%; font-weight: 600; font-size: 0.8rem; }
  .n-title { font-family: var(--display); font-weight: 700; letter-spacing: -0.01em; font-size: 1.18rem; line-height: 1.1; }
  .n-blurb { color: var(--ink-2); font-size: 0.95rem; line-height: 1.5; }
  .n-tags { color: var(--ink-3); font-size: 0.7rem; }
  .note:hover .n-title { color: var(--blue); }
  .none { margin-top: 12px; color: var(--ink-3); }
  @media (max-width: 1080px) {
    .note { grid-template-columns: 56px minmax(0, 1fr); }
    .n-blurb, .n-tags { grid-column: 2; border-left: 1px solid var(--rule); border-top: 1px solid var(--rule); }
    .n-code { grid-row: 1 / 4; }
  }
</style>
