{
  "name": "caliban-user-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "description": "Caliban user documentation: an Astro Starlight site built to static files under /docs/, with offline Pagefind search.",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check:contract": "node scripts/check-contract.mjs",
    "check:offline": "node scripts/check-offline.mjs",
    "gen:api": "node scripts/gen-api-reference.mjs",
    "verify": "npm run check:dashes && npm run build && npm run check:links && npm run check:contract && npm run check:offline",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
